# Django API
api.ecom-auto-ai.org {
    # Django static files
    handle /static/* {
        root * /srv
        file_server
    }

    # Media uploads
    handle /media/* {
        root * /srv
        file_server
    }

    # Everything else → Gunicorn
    reverse_proxy web:8000
}

# React SPA
app.ecom-auto-ai.org {
    root * /srv/frontend
    file_server
    # SPA fallback: unknown paths → index.html (React Router handles them)
    try_files {path} /index.html
}

# n8n (separate stack, same proxy network)
n8n.ecom-auto-ai.org {
    reverse_proxy n8n:5678
}

modeline.online, www.modeline.online {
    reverse_proxy modeline_edge:80
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }
}

# Solvix (separate stack in /srv/solvix, same proxy network)
solvix-app.online, www.solvix-app.online {
    encode gzip

    handle /api/* {
        reverse_proxy solvix-backend:4000
    }

    # Link-preview crawlers (Meta/WhatsApp/Twitter/etc.) fetch raw HTML and never
    # run the SPA's JS, so /projects/:slug would show no title/image in ad and
    # share previews. Route just those user agents to the backend's SSR-lite
    # OG-tag route (see backend/src/routes/share.js); everyone else still gets
    # the normal React app below.
    @socialbot {
        path /projects/*
        header_regexp User-Agent (?i)(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Slackbot|Discordbot|Googlebot|bingbot)
    }
    handle @socialbot {
        reverse_proxy solvix-backend:4000
    }

    handle {
        root * /srv/solvix-frontend
        file_server
        try_files {path} /index.html
    }
}
